<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}{{ storeName }}{% endblock %}</title>
  <link rel="stylesheet" href="/static/css/style.css">
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='8' fill='%231f4fd8'/%3E%3Ctext x='16' y='22' font-size='18' text-anchor='middle' fill='white' font-family='Arial'%3EP%3C/text%3E%3C/svg%3E">
</head>
<body>
  <div class="topbar"><div class="container"><span>₺500 üzeri siparişlerde ücretsiz kargo</span><span>Destek: 0850 222 00 00 · destek@pusula.local</span></div></div>
  <header class="site">
    <div class="container">
      <a class="brand" href="/"><span class="logo">P</span>{{ storeName }}</a>
      <form class="search" action="/" method="get">
        <input type="search" name="q" placeholder="Ürün, kategori veya marka ara" value="{{ q }}">
        <button class="btn" type="submit">Ara</button>
      </form>
      <nav class="main">
        <a href="/">Ürünler</a>
        <a class="cart-link" href="/cart">Sepet <span class="count" data-cart-count style="display:none">0</span></a>
        {% if user %}
          <a href="/orders">Siparişlerim</a>
          {% if user.role == 'admin' %}<a href="/admin">Yönetim</a>{% endif %}
          {% if user.role == 'vendor' %}<a href="/vendor">Satıcı Paneli</a>{% endif %}
          <a class="user-menu" href="/account">
            <span class="avatar">{% if user.avatar_url %}<img src="{{ user.avatar_url }}" alt="">{% else %}{{ user.name[0] | upper }}{% endif %}</span>
            <span>{{ user.name.split(' ')[0] }}</span>
          </a>
          <a href="/logout">Çıkış</a>
        {% else %}
          <a href="/login">Giriş</a>
          <a class="btn small" href="/register">Kayıt ol</a>
        {% endif %}
      </nav>
    </div>
  </header>
  <main><div class="container">
    {% block content %}{% endblock %}
  </div></main>
  <footer>
    <div class="container">
      <div>© 2026 Pusula Teknoloji A.Ş. · v{{ version }}</div>
      <div><a href="#">Hakkımızda</a><a href="#">İade Koşulları</a><a href="#">KVKK Aydınlatma Metni</a><a href="#">Satıcı Olun</a><a href="#">İletişim</a></div>
    </div>
  </footer>
  <script src="/static/js/app.js"></script>
  {% block scripts %}{% endblock %}
</body>
</html>
