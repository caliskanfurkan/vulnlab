{% extends "layout.njk" %}
{% block title %}Giriş yap — {{ storeName }}{% endblock %}
{% block content %}
<div class="auth-box panel">
  <h1>Giriş yap</h1>
  <form id="login-form">
    <div class="field"><label>E-posta</label><input type="email" name="email" required autocomplete="username"></div>
    <div class="field"><label>Şifre</label><input type="password" name="password" required autocomplete="current-password"></div>
    <div id="notice"></div>
    <button class="btn" type="submit" style="width:100%">Giriş yap</button>
  </form>
  <form id="otp-form" style="display:none">
    <p class="help" id="otp-message"></p>
    <div class="field"><label>Doğrulama kodu</label><input name="code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" required placeholder="4 haneli kod"></div>
    <div id="otp-notice"></div>
    <button class="btn" type="submit" style="width:100%">Doğrula</button>
  </form>
  <p class="help" style="margin-top:16px"><a href="/forgot">Şifremi unuttum</a> · Hesabınız yok mu? <a href="/register">Kayıt olun</a></p>
</div>
{% endblock %}
{% block scripts %}
<script>
(function () {
  const { api, showNotice } = window.Pusula;
  const next = {{ next | dump | safe }};
  const loginForm = document.getElementById('login-form');
  const otpForm = document.getElementById('otp-form');
  let challengeId = null;

  loginForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(loginForm);
    try {
      const data = await api('/api/v2/auth/login', { method: 'POST', body: { email: fd.get('email'), password: fd.get('password') } });
      if (data.otp_required) {
        challengeId = data.challenge_id;
        document.getElementById('otp-message').textContent = data.message;
        loginForm.style.display = 'none';
        otpForm.style.display = '';
        return;
      }
      location.href = next || '/';
    } catch (err) { showNotice('#notice', 'error', err.message); }
  });

  otpForm.addEventListener('submit', async (e) => {
    e.preventDefault();
    const fd = new FormData(otpForm);
    try {
      await api('/api/v2/auth/otp', { method: 'POST', body: { challenge_id: challengeId, code: fd.get('code') } });
      location.href = next || '/';
    } catch (err) { showNotice('#otp-notice', 'error', err.message); }
  });
})();
</script>
{% endblock %}
